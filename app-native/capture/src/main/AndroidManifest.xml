<?xml version="1.0" encoding="utf-8"?>
<!-- Declared here so they MERGE into any consuming app automatically (the standalone native app
     AND the Unity APK). CAMERA = UVC capture; usb.host = external USB devices.
     NOTE: the Unity-launcher USB_DEVICE_ATTACHED intent-filter is intentionally NOT here — it
     targets com.unity3d.player.UnityPlayerActivity, which only exists in the Unity APK. Putting it
     in this shared AAR would make the manifest merger fabricate that activity in the standalone
     native app (breaking the Android-12 exported check, and wiring USB attach to a missing class).
     It now lives in app/Assets/Plugins/Android/AndroidManifest.xml (Unity-only). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- PICO 4 Ultra / Horizon OS entitlement that exposes an external USB camera to Camera2.
         EgoKit declares this; without it openCamera() on the LENS_FACING_EXTERNAL id is denied.
         Unknown/ignored on non-Horizon devices (e.g. a phone), so it merges harmlessly. -->
    <uses-permission android:name="horizonos.permission.USB_CAMERA" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.camera.external" android:required="false" />
</manifest>
