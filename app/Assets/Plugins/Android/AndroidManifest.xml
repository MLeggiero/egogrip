<?xml version="1.0" encoding="utf-8"?>
<!-- Unity-only Android manifest additions (merged into the generated Unity APK manifest).
     This grafts a USB_DEVICE_ATTACHED intent-filter + device_filter onto Unity's launcher activity
     so attaching a UVC camera auto-grants USB permission (with the user's one-time "always" tick)
     and can auto-launch the app. It lives HERE (not in the shared egogrip-capture.aar) because it
     targets the Unity player activity, which only exists in the Unity build — putting it in the AAR
     broke the standalone native app's manifest merge (Android-12 android:exported check).

     @xml/device_filter is supplied by egogrip-capture.aar (capture/src/main/res/xml/device_filter.xml).

     ⚠ VERIFY the activity name against Player Settings ▸ Other Settings ▸ Application Entry Point:
       - "Activity"     → com.unity3d.player.UnityPlayerActivity  (used below)
       - "GameActivity" → com.unity3d.player.UnityPlayerGameActivity  (rename the android:name below) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
